# RWA Launchpad frontend: environment variables
# Copy to `.env.local`. Los valores de abajo son el despliegue de testnet de la
# entrega de semana 4 (ids publicos, no hay secretos aca).

# Soroban contract id for rwa-launchpad (dia-3). Required for all on-chain calls.
NEXT_PUBLIC_CONTRACT_ID=CBP2EIV53RRKFSOHSSNY4APZHIEQHBLQNRXYXVER2FKLX5PXSJWUB4SC

# SAC / payment token contract id used when initializing AssetInfo.payment_token.
# Prefills the admin initialize form; still editable in the UI.
NEXT_PUBLIC_PAYMENT_TOKEN_ID=CACR6IIUQ32FSPNWQG55BT6X77VSBUUQ7ZA3GJFMZ42ZMXJ2TFBIZMES

# Admin G-address that owns initialize / mint / whitelist / pause / withdraw.
# Used to gate the /admin UI (instructors: connect this Freighter account).
NEXT_PUBLIC_ADMIN_ADDRESS=GAJVFEEYVTYEYKECCMNO2WESXWKTEXP3JUHX7T2YPORNISE2WQEIJYZV

# Network name: testnet | public | futurenet (default: testnet)
NEXT_PUBLIC_NETWORK=testnet

# Optional override; defaults to https://soroban-testnet.stellar.org for testnet.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
